# ==========================================
# RoadmapXpress Environment Configuration
# ==========================================

# 1. Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Publishable Key (Client & User-Session Server Client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# 3. Supabase Secret Key (Server-Side Privileged API Only)
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# 4. Site URL for Auth confirmation redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
