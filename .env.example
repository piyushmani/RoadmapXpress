# ==========================================
# RoadmapXpress Environment Configuration
# ==========================================

# 1. Supabase Project URL (Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Publishable / Anon Key (Client & User-Session Server Client)
# Accepts either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 3. Supabase Secret / Service Role Key (Server-Side Privileged API Only)
# Accepts either SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 4. Site URL for Auth confirmation redirects (e.g. https://your-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
