# ==========================================
# RoadmapXpress Environment Configuration
# ==========================================

# Supabase URL & Publishable Key (New sb_publishable_... format)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key-here

# Supabase Secret Key (New sb_secret_... format, server-side only)
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key-here

# Site URL for Auth confirmation redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of admin emails authorized to edit roadmaps
ADMIN_EMAILS=admin@roadmapxpress.com,admin@example.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@roadmapxpress.com,admin@example.com
